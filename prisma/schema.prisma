// ZAID Minage — Prisma schema
// PostgreSQL (Neon) — run `npx prisma migrate dev` after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
}

enum DeliveryMethod {
  HOME
  STOP_DESK
}

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String?
  role         Role       @default(CLIENT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     Wishlist[]

  @@index([phone])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  fullName  String
  phone     String
  wilaya    String
  city      String
  street    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  nameAr    String
  nameFr    String
  slug      String    @unique
  image     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]

  @@index([slug])
}

model Product {
  id              String    @id @default(cuid())
  nameAr          String
  nameFr          String
  slug            String    @unique
  descriptionAr   String
  descriptionFr   String
  price           Int       // in DZD, integer (no decimals in circulation)
  comparePrice    Int?
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  stock           Int       @default(0)
  sku             String    @unique
  images          String[]  // Cloudinary URLs
  material        String?
  color           String?
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        Wishlist[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Color", "Size"
  value           String   // e.g. "Gold", "Large"
  priceAdjustment Int      @default(0)
  stock           Int      @default(0)

  orderItems      OrderItem[]

  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique // ZM-2026-XXXX
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  status         OrderStatus    @default(PENDING)
  subtotal       Int
  shippingFee    Int
  total          Int
  paymentMethod  PaymentMethod  @default(COD)
  deliveryMethod DeliveryMethod @default(HOME)
  wilaya         String
  city           String
  address        String
  fullName       String
  phone          String
  email          String?
  notes          String?
  stripeSessionId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([wilaya])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Int
  totalPrice Int

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      // 1-5
  comment    String
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ShippingRate {
  id       String @id @default(cuid())
  wilaya   String @unique
  homeFee  Int
  deskFee  Int
}
